{
  "name": "elevve-clinic-intestino-landing-page",
  "version": "1.0.0",
  "description": "Landing page de Restauração Intestinal - Elevve Clinic",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npx tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch\" \"npx live-server --port=3000\"",
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "build": "npm run build:css",
    "preview": "npx live-server --port=3000"
  },
  "keywords": [
    "landing-page",
    "elevve-clinic",
    "saude-intestinal",
    "modulacao-intestinal"
  ],
  "author": "Elevve Clinic",
  "license": "UNLICENSED",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/container-queries": "^0.1.1",
    "tailwindcss": "^3.4.1",
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2"
  }
}
