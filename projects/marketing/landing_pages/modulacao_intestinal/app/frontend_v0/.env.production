# ===========================================
# CONFIGURAÇÃO - MODO REMOTO (PRODUÇÃO)
# ===========================================
# Este arquivo É COMMITADO no Git como template de configuração de produção
# Para usar: copiar para .env na raiz do frontend
# Exemplo: cp .env.production .env
# 
# ⚠️ ATENÇÃO: Antes de commitar, substitua os valores placeholder pelos reais:
#   - WHATSAPP_NUMBER: número real da clínica
#   - GA4_ID: ID real do Google Analytics
#   - GTM_ID: ID real do Google Tag Manager
#   - CALENDLY_URL: link real de agendamento
# 
# O arquivo .env (ativo) NUNCA deve ser commitado!

# Ambiente
NODE_ENV=production
MODE=production

# URL Base para produção
BASE_URL=https://www.elevveclinic.com.br/intestino

# WhatsApp - Número REAL da clínica (SUBSTITUIR PELO NÚMERO CORRETO)
WHATSAPP_NUMBER=5511999999999
WHATSAPP_MESSAGE=Olá! Vim pela landing page e gostaria de agendar uma avaliação metabólica.

# Calendly (opcional) - Link REAL de agendamento
CALENDLY_URL=https://calendly.com/elevveclinic

# Google Analytics - ID DA PROPRIEDADE DE PRODUÇÃO (SUBSTITUIR)
GA4_ID=G-XXXXXXXXXX
GTM_ID=GTM-XXXXXXX

# Debug Mode - Desativado em produção
DEBUG_MODE=false

# Analytics Ativado em produção
ANALYTICS_ENABLED=true

# API Endpoints (se houver integração futura)
API_BASE_URL=https://www.elevveclinic.com.br/api

# Feature Flags
ENABLE_NEWSLETTER=true
ENABLE_COOKIE_CONSENT=true

# Domínio principal
DOMAIN=elevveclinic.com.br
SUBDOMAIN=intestino

# SSL/HTTPS forçado
FORCE_HTTPS=true
