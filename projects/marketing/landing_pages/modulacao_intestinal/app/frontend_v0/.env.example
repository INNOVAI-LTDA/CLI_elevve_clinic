# ===========================================
# ARQUIVO .env.example - TEMPLATE PARA COMMIT
# ===========================================
# Este arquivo É commitado no Git como referência
# Os arquivos .env.local e .env.production também são commitados
# O arquivo .env (ativo) NUNCA deve ser commitado - use .gitignore
# 
# Para usar em desenvolvimento: cp .env.local .env
# Para usar em produção: cp .env.production .env

# Ambiente (local ou production)
NODE_ENV=development
MODE=local

# URL Base
BASE_URL=http://localhost:3000

# WhatsApp Configuration
WHATSAPP_NUMBER=5511999999999
WHATSAPP_MESSAGE=Olá! Vim pela landing page e gostaria de agendar uma avaliação metabólica.

# Calendly (opcional)
CALENDLY_URL=https://calendly.com/

# Google Analytics (vazio em desenvolvimento)
GA4_ID=
GTM_ID=

# Debug Mode
DEBUG_MODE=true

# Analytics
ANALYTICS_ENABLED=false

# API Endpoints
API_BASE_URL=http://localhost:3000/api

# Feature Flags
ENABLE_NEWSLETTER=false
ENABLE_COOKIE_CONSENT=true
