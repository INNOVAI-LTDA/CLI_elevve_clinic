# ===========================================
# .gitignore - Frontend Landing Page
# ===========================================

# Variáveis de ambiente
# .env (ativo) NUNCA deve ser commitado - contém dados sensíveis do ambiente atual
.env
# .env.local e .env.production PODEM ser commitados - são templates de configuração
!.env.local
!.env.production
# .env.example é o template base - sempre commitado
!.env.example

# Dependências
node_modules/
package-lock.json

# Build output
dist/
build/
*.min.css
*.min.js

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
Thumbs.db

# Test coverage
coverage/

# Temporary files
tmp/
temp/
.cache/

# Tailwind CSS build (gerado automaticamente)
css/output.css
!css/input.css

# Imagens otimizadas (se forem geradas automaticamente)
# images/*.webp
# !images/.gitkeep
