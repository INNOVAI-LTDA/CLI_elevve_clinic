# ===========================================
# .gitignore - Frontend Landing Page
# ===========================================

# Variáveis de ambiente (NUNCA commitar dados sensíveis)
.env
.env.local
.env.production
!.env.example

# Dependências
node_modules/
package-lock.json

# Build output
dist/
build/
*.min.css
*.min.js

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
Thumbs.db

# Test coverage
coverage/

# Temporary files
tmp/
temp/
.cache/

# Tailwind CSS build (gerado automaticamente)
css/output.css
!css/input.css

# Imagens otimizadas (se forem geradas automaticamente)
# images/*.webp
# !images/.gitkeep
