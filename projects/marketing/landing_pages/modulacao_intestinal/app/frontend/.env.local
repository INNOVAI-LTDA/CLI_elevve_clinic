# ===========================================
# CONFIGURAÇÃO - MODO LOCAL (DESENVOLVIMENTO)
# ===========================================
# Este arquivo É COMMITADO no Git como template de configuração local
# Para usar: copiar para .env na raiz do frontend
# Exemplo: cp .env.local .env
# 
# IMPORTANTE: O arquivo .env (ativo) NUNCA deve ser commitado!
# Este arquivo contém valores de exemplo/sandbox seguros para desenvolvimento

# Ambiente
NODE_ENV=development
MODE=local

# URL Base para desenvolvimento
BASE_URL=http://localhost:3000

# WhatsApp - Número de teste/sandbox (substituir se necessário)
WHATSAPP_NUMBER=5511999999999
WHATSAPP_MESSAGE=Olá! Vim pela landing page e gostaria de agendar uma avaliação metabólica.

# Calendly (opcional) - Link de teste
CALENDLY_URL=https://calendly.com/

# Google Analytics - ID de propriedade de teste (ou vazio para desativar)
GA4_ID=
GTM_ID=

# Debug Mode - Ativado para desenvolvimento
DEBUG_MODE=true

# Analytics Desativado por padrão em desenvolvimento
ANALYTICS_ENABLED=false

# API Endpoints (se houver integração futura)
API_BASE_URL=http://localhost:3000/api

# Feature Flags
ENABLE_NEWSLETTER=false
ENABLE_COOKIE_CONSENT=true
