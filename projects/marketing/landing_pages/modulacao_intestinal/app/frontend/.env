# ===========================================
# ARQUIVO .env.example - TEMPLATE PARA COMMIT
# ===========================================
# Este arquivo É commitado no Git como referência
# NUNCA comite arquivos .env.local ou .env.production com dados reais
#
# Para usar em desenvolvimento: cp .env.example .env
# Para produção: configure as variáveis no painel da Vercel

# Ambiente (development ou production)
NODE_ENV=development
VITE_MODE=local

# URL Base
VITE_BASE_URL=http://localhost:5173
VITE_BASE_PATH=/intestino/

# CTA principal (preferencial para tráfego pago / Meta Pixel)
# Use uma URL de proxy para rastrear cliques antes do redirecionamento ao WhatsApp
VITE_CTA_PROXY_URL=https://dracristal.com.br/mod-whatsapp

# Status de tracking permitido: val, tst, prod
VITE_TRACKING_STATUS=tst

# WhatsApp Configuration
VITE_WHATSAPP_NUMBER=5511999999999
VITE_WHATSAPP_MESSAGE=Olá! Vim pela landing page e gostaria de agendar uma avaliação metabólica.

# Calendly (opcional)
VITE_CALENDLY_URL=https://calendly.com/

# Google Analytics (vazio em desenvolvimento)
VITE_GA4_ID=
VITE_GTM_ID=

# Debug Mode
VITE_DEBUG_MODE=true

# Analytics
VITE_ANALYTICS_ENABLED=false

# API Endpoints
VITE_API_BASE_URL=http://localhost:5173/api

# Feature Flags
VITE_ENABLE_NEWSLETTER=false
VITE_ENABLE_COOKIE_CONSENT=true
